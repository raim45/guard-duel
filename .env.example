# Guard Duel Environment Variables
# Copy to .env.local and fill in your values

# Supabase (get from your Supabase project dashboard)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Model Providers (at least one required for each role)
# Groq (recommended for free tier)
GROQ_API_KEY=your-groq-api-key

# Optional: OpenAI
# OPENAI_API_KEY=your-openai-api-key

# Optional: Together AI
# TOGETHER_API_KEY=your-together-api-key

# Optional: Google Gemini (OpenAI compatible)
# GEMINI_API_KEY=your-gemini-api-key

# Optional: Ollama (local development)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_API_KEY=ollama  # Ollama doesn't require a real key