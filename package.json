  "devDependencies": {
    "@types/node": "^22.7.0",
    "dotenv": "^18.0.10",
    "eslint": "^9.11.0",
    "pnpm": "^9.11.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.2",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.11.0"
}
